# Copy to .env and fill in. Never commit .env.
# Sponsor keys come from the /costar-keys command in the HackPrinceton Discord (#costar-group).
# A human runs that command and accepts the sponsor terms; agents do not.

# fixture | live
SNAPBACK_DATA_SOURCE=fixture

# Matterport Model API (key is the user name, token is the password)
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# Vexcel aerial imagery (covers Houston and Los Angeles only)
VEXCEL_API_KEY=

# CoStar record kit: zip password plus either the download link or a local path
COSTAR_ZIP_PASSWORD=
COSTAR_KIT_URL=
COSTAR_KIT_ZIP=

# Language model used for explanations only (it never sets a verdict)
ANTHROPIC_API_KEY=

# Where the intake sidecar and the web app find the API
API_URL=http://localhost:8000

# Photon: add the variable names from Photon's docs here when the sidecar is wired.
