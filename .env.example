# Copy to .env and fill in. Never commit .env.
# Sponsor keys come from the /costar-keys command in the HackPrinceton Discord (#costar-group).
# A human runs that command and accepts the sponsor terms; agents do not.

# fixture | live
SNAPBACK_DATA_SOURCE=fixture

# Where the web app lives. Verify links on cards point here.
SNAPBACK_PUBLIC_BASE_URL=http://localhost:5173

# After the renter approves the challenge: stand_in answers at once from the fixture;
# reply waits for the poster's real photo (POST /cases/{id}/reply) and checks it.
SNAPBACK_CHALLENGE=stand_in

# The zone a card's times are shown in: the building's. Houston is America/Chicago.
SNAPBACK_CARD_TIMEZONE=America/Chicago

# A staged demo case from fixtures/demo: a, b or c. Leave empty for normal runs.
DEMO_CASE=

# Who makes the agent's choices: policy (code, no key needed) or deepagents
# (needs `uv sync --extra agent` and ANTHROPIC_API_KEY).
SNAPBACK_AGENT=policy

# LangSmith tracing for the deepagents path. A human creates the key (AGENTS.md rule 8); leave
# empty to keep tracing off. With a key, runs show the todo list, each sub-agent and its files.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=snapback

# Pause between trace events on the SSE route, in milliseconds. 0 sends them as they happen.
SNAPBACK_TRACE_PACE_MS=0

# What opens GET /events/stream (sent as Authorization: Bearer, never in the address). Leave
# empty to keep the stream closed.
SNAPBACK_EVENTS_TOKEN=

# Checks one renter (or one browser) may start per day, and the ceiling per network address.
SNAPBACK_DAILY_LIMIT=3
SNAPBACK_DAILY_LIMIT_PER_ADDRESS=100

# The eval results file that `make eval` writes. Served read-only at GET /eval/results.csv.
SNAPBACK_EVAL_RESULTS=eval/results.csv
# The same for locate accuracy on the kit's own photos (`make eval-locate-real`).
SNAPBACK_EVAL_LOCATE_REAL=eval/locate_real.csv

# Upload caps: photos per check, and megabytes per photo.
SNAPBACK_MAX_PHOTOS=10
SNAPBACK_MAX_PHOTO_MB=10

# Live locator: the index folder under data/index/ used to place a live case's photos, and
# the seconds one case may spend placing them (a photo not done in time reads "not located").
SNAPBACK_LOCATE_INDEX=demo
SNAPBACK_LOCATE_BUDGET_S=25

# Matterport Model API (key is the user name, token is the password)
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Demo buildings for the locate index and the twin page: comma-separated Matterport model ids.
# Local .env only: real model ids never go into git (sponsor terms 3.2).
DEMO_MODEL_IDS=

# Recapture detector on reply photos (V4): off by default; on needs data/recapture/v0.json
RECAPTURE_MODEL=off

# Vexcel aerial imagery (covers Houston and Los Angeles only)
VEXCEL_API_KEY=

# CoStar record kit: zip password plus either the download link or a local path
COSTAR_ZIP_PASSWORD=
COSTAR_KIT_URL=
COSTAR_KIT_ZIP=

# Salt for hashing phone numbers, so a listing's number is compared with the leasing office's
# without either being kept. Leave empty to have one made per run. A human sets this, if at all.
SNAPBACK_PHONE_SALT=

# Language model used for explanations only (it never sets a verdict)
ANTHROPIC_API_KEY=

# Finder voice: ElevenLabs text to speech and speech to text (Scribe). A human creates the key.
# Empty: the voice routes answer 503 and the web app types only (browser dictation as fallback).
ELEVENLABS_API_KEY=
# A warm, natural voice from the ElevenLabs library ("Sarah" by default) and the TTS model.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Where the intake sidecar and the web app find the API
API_URL=http://localhost:8000

# Photon (Spectrum, iMessage) for the intake sidecar. Without both the sidecar only logs.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Thread ids, or the keyed hashes (imsg-...) the sidecar logs for a thread it ignored
SIDECAR_ALLOWED_THREADS=
SIDECAR_RENTER_SALT=
# The public site the reply links to (a renter's phone opens it): never localhost.
WEB_URL=
# iMessage stage switches: each is on only when set to 1, so either can be turned off on stage.
# The card picture after the report, and the "Got it. Checking..." reply before a check.
SNAPBACK_SEND_CARD_IMAGE=1
SNAPBACK_SEND_CHECKING=1
# W1 web sub-agent: the building's own site, the ad's link, the same home posted elsewhere.
# Each check runs only when its key is set; a missing key reads "not checked".
BRIGHTDATA_API_TOKEN=
APIFY_TOKEN=
BROWSER_USE_API_KEY=
# Bright Data zone names, not secret: create a Web Unlocker zone and a SERP API zone.
BRIGHTDATA_UNLOCKER_ZONE=snapback_unlocker
BRIGHTDATA_SERP_ZONE=snapback_serp
